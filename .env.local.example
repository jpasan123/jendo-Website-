# Jendo Chatbot Configuration

# Auth service used to obtain a bearer token before calling the chatbot backend
CHATBOT_AUTH_URL=http://188.166.240.119:8080/api/auth/login
CHATBOT_AUTH_EMAIL=
CHATBOT_AUTH_PASSWORD=

# Spring Boot Chatbot Backend API URL
CHATBOT_BACKEND_URL=http://188.166.240.119:8090/api/chatbot/message

# Optional static token if the proxy must call the chatbot service directly
CHATBOT_BACKEND_TOKEN=

# Hugging Face API Token (OPTIONAL - for higher rate limits)
# Get free token at: https://huggingface.co/settings/tokens
# Without token: ~50-100 requests/hour
# With token: 1000+ requests/hour
HUGGINGFACE_TOKEN=

# Next.js Configuration
NEXT_PUBLIC_GA_ID=your_google_analytics_id


# --- Jendo test booking (/book-test and /admin/bookings) ---
# PostgreSQL connection string. Tables are created automatically on first use.
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/jendo_bookings
# Password for /admin/bookings (min 8 chars) and a long random secret for the login cookie
BOOKING_ADMIN_PASSWORD=
BOOKING_SESSION_SECRET=
# Where payment slips are stored (private folder, outside the repo and public/)
BOOKING_UPLOAD_DIR=/var/www/jendo-data/booking-slips
# Bank details shown to patients who choose to pay online
BOOKING_BANK_NAME=
BOOKING_BANK_ACCOUNT_NAME=
BOOKING_BANK_ACCOUNT_NUMBER=
BOOKING_BANK_BRANCH=
BOOKING_BANK_NOTE=
# Optional: email the team when a booking arrives (needs SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASSWORD)
BOOKING_NOTIFY_EMAIL=
